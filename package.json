{
  "name": "knowledge-service",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone enterprise knowledge service",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "postinstall": "pnpm prisma:generate",
    "build": "pnpm prisma:generate && turbo build",
    "test": "turbo test",
    "dev": "pnpm --filter @octopus/knowledge-service dev",
    "start": "pnpm --filter @octopus/knowledge-service start",
    "prisma:generate": "pnpm --filter @octopus/knowledge-service exec prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "pnpm --filter @octopus/knowledge-service exec prisma migrate deploy --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "@prisma/client": "6",
    "@types/node": "^22.0.0",
    "prisma": "6",
    "tsx": "^4.7.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
