KNOWLEDGE_SERVICE_PORT=8080
KNOWLEDGE_SERVICE_TOKEN=dev-knowledge-token
KNOWLEDGE_SOURCE_SYSTEM_ID=knowledge
# Optional. When set, relational stores use Prisma/MySQL; otherwise runtime uses in-memory stores.
# Run prisma generate/migrate with services/knowledge/prisma/schema.prisma before enabling.
KNOWLEDGE_DATABASE_URL=
KNOWLEDGE_NONCE_TTL_MS=600000
KNOWLEDGE_CLOCK_SKEW_MS=300000

# Development only. Keep false by default; set true manually for local plugin tests without real Octopus identity context.
KNOWLEDGE_ALLOW_ENV_IDENTITY=false
OCTOPUS_KNOWLEDGE_TOKEN=dev-knowledge-token
OCTOPUS_USER_ID=user-dev-001
OCTOPUS_TENANT_ID=tenant-default
OCTOPUS_DEPARTMENTS=
OCTOPUS_ROLES=

# Document parser. Use MinerU for PDFs/layout-heavy documents in standalone deployments.
PARSER_PROVIDER=mineru
MINERU_HTTP_ENDPOINT=http://localhost:8000
MINERU_AUTH_TOKEN=
MINERU_TIMEOUT_MS=120000
